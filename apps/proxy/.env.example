# Host tujuan yang boleh dihubungi proxy. Diisi dari `hosts[]` di manifest
# extension yang terpasang. Kosong = tolak semua permintaan.
PROXY_ALLOWED_HOSTS=api.mangadex.org,uploads.mangadex.org,mangadex.org

# Origin browser yang boleh memanggil proxy. Kosong = izinkan semua (hanya untuk dev).
PROXY_ALLOWED_ORIGINS=http://localhost:5180

PROXY_HOST=127.0.0.1
PROXY_PORT=5181

# Batas ukuran respons /fetch. /stream tidak terpengaruh — dia tidak pernah buffer.
PROXY_MAX_BODY_BYTES=8388608

LOG_LEVEL=info
