# Pembatas host tujuan, OPSIONAL. Kosong = host publik mana pun boleh.
#
# Sengaja dikosongkan: sumber dipasang pengguna saat app jalan, sedangkan daftar
# ini dibaca sekali waktu proxy start — extension apa pun yang dipasang setelah
# itu pasti kena 403. Yang menjaga mesin ini adalah gerbang alamat internal di
# guard.ts, dan itu selalu aktif. Isi hanya kalau proxy dipakai bersama-sama.
PROXY_ALLOWED_HOSTS=

# Origin browser yang boleh memanggil proxy. Kosong = izinkan semua (hanya untuk dev).
PROXY_ALLOWED_ORIGINS=http://localhost:5180

PROXY_HOST=127.0.0.1
PROXY_PORT=5181

# Batas ukuran respons /fetch. /stream tidak terpengaruh — dia tidak pernah buffer.
PROXY_MAX_BODY_BYTES=8388608

LOG_LEVEL=info
