{
  // Test punya tsconfig sendiri karena tiap paket sengaja dikunci ketat: paket
  // extension jalan dengan `types: []` supaya API-nya tidak diam-diam memakai
  // tipe Node. Test butuh sebaliknya. Tanpa berkas ini test tidak pernah
  // di-typecheck sama sekali — vitest cuma menjalankan, tidak memeriksa tipe —
  // dan salah urutan argumen baru ketahuan waktu assertion-nya merah.
  "extends": "./tsconfig.base.json",
  "include": ["*/*/test/**/*.ts", "vitest.config.ts"],
  "compilerOptions": {
    "noEmit": true,
    "composite": false,
    "lib": ["ES2023", "DOM"],
    // `vite/client` wajib ikut: test mengimpor modul `src/` yang menyeret
    // tetangganya, dan di antaranya ada `import.meta.env` serta impor aset
    // `?url`. Keduanya cuma dikenal lewat tipe klien Vite.
    "types": ["node", "vite/client"],
    "allowImportingTsExtensions": true,
    // Alias yang sama dengan `tsconfig.app.json`. Test mengimpor `src/` lewat
    // path relatif, tapi berkas yang diimpornya memakai `@/`.
    "paths": {
      "@/*": ["./apps/app/src/*"]
    }
  }
}
