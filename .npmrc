# CLI Capacitor mencari plugin native dengan menyisir node_modules secara datar
# (baca `package.json` tiap folder di level teratas). Struktur symlink bawaan
# pnpm bikin `cap sync` nggak menemukan satu pun plugin. Jangan diubah selama
# apps/app masih pakai Capacitor.
node-linker=hoisted

# Extension pihak ketiga di-bundle, bukan di-install — tapi toolchain-nya (esbuild,
# vite, sqlite) butuh script instalasi supaya binary-nya kebentuk.
strict-peer-dependencies=false
